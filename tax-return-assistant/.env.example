# Environment variable NAMES used by the Tax Return Assistant. No values here, ever.
#
# Set real values as Windows *user* environment variables (Start > "Edit environment
# variables for your account"), or in PowerShell:
#   [Environment]::SetEnvironmentVariable("TRA_HOME", "C:\TaxAssistant", "User")
# Never put credentials in this file, in config/, or anywhere in the repository.

# Folder for client data. Must be on this computer: not OneDrive, Dropbox or Google Drive,
# and not inside a git repository. setup.ps1 sets this for you.
TRA_HOME=

# Where documents are filed: local (default) or fyi.
TRA_STORE=

# Optional: the firm's client code format as a regular expression (default ^[A-Z0-9]{2,12}$).
TRA_CLIENT_CODE_PATTERN=

# Xero (sole trader clients). The client ID of the firm's Xero app; there is no secret
# (sign-in uses PKCE). Tokens are kept in Windows Credential Manager, not here.
XERO_CLIENT_ID=

# FYI Docs. Issued by FYI for the firm's integration.
FYI_BASE_URL=
FYI_ACCESS_ID=
FYI_ACCESS_SECRET=
FYI_APP_ID=
