# Client data must never be committed. Block every format a client document,
# workpaper or export could take; tests generate their own fake data at runtime.
*.pdf
*.xlsx
*.xls
*.csv
*.jsonl
.env
.venv/
build/
dist/
!tests/**
!config/**
# After the re-includes, so they can't re-include build output.
__pycache__/
*.pyc
*.egg-info/
