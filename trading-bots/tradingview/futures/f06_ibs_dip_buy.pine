//@version=6
// F06 - IBS dip buy on index futures (Pagonidis 2013 IBS effect, bot 07 in contracts).
// Chart: MNQ1!/NQ1! or MES1!/ES1! on 5 or 15 minutes, extended hours ON.
// The regular session (09:30-16:00) high, low and close are tracked on the chart. At the 16:00 bar:
// IBS = (close - low) / (high - low). Buy 1 contract when IBS < X; sell at a 16:00 close above the
// previous session's high or with IBS > 0.8. Held overnight (futures trade through the night).
// Validated on Nasdaq-100 1-minute data, 1 MNQ (X = 0.25): 2011-2021 +$2,120/yr; 2022-2026
// +$4,705/yr, profit factor 1.60, 72% winners, worst fall -$4,957. ES (X = 0.2): +$1,337/yr. Grade A on NQ.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("F06 IBS dip buy", overlay = true, process_orders_on_close = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1)

buyBelow = input.float(0.25, "Buy when IBS is below", step = 0.05)
sellAbove = input.float(0.80, "Sell when IBS is above", step = 0.05)

string TZ = "America/New_York"
bool inSess = not na(time(timeframe.period, "0930-1600", TZ))
bool newDay = inSess and (not inSess[1] or dayofmonth(time, TZ) != dayofmonth(time[1], TZ))
bool atClose = inSess and hour(time_close, TZ) == 16 and minute(time_close, TZ) == 0

var float hi = na
var float lo = na
var float prevHi = na
if newDay
    hi := high
    lo := low
else if inSess
    hi := math.max(hi, high)
    lo := math.min(lo, low)

if atClose and not na(hi)
    float ibs = hi != lo ? (close - lo) / (hi - lo) : 0.5
    if strategy.position_size > 0 and ((not na(prevHi) and close > prevHi) or ibs > sellAbove)
        strategy.close("Long")
    else if strategy.position_size == 0 and ibs < buyBelow
        strategy.entry("Long", strategy.long)
    prevHi := hi
if timeframe.isdaily
    runtime.error("Use a 5 or 15 minute chart with extended hours on.")
