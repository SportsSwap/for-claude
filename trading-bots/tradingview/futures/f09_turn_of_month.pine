//@version=6
// F09 - Turn of the month on index futures (Lakonishok & Smidt 1988; McConnell & Xu 2008).
// Daily chart of MNQ1!/NQ1! or MES1!/ES1!. Buy 1 contract at the close N trading days before month end,
// sell at the close of trading day M of the new month. Weekends are skipped; exchange holidays are not.
// Futures test, 1 MNQ (5 days before, out on day 4): 2011-2021 +$1,303/yr; 2022-2026 +$1,709/yr,
// but only +$74/yr since Aug 2024. Grade C on futures. Use on a daily chart of MNQ1!/NQ1!/MES1!/ES1!.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("F09 Turn of the month", overlay = true, process_orders_on_close = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1)

before = input.int(5, "Enter N trading days before month end", minval = 1)
after  = input.int(4, "Exit at the close of trading day M", minval = 1)

int y = year(time)
int mo = month(time)
int d = dayofmonth(time)
int dim = mo == 2 ? (y % 4 == 0 ? 29 : 28) : (mo == 4 or mo == 6 or mo == 9 or mo == 11) ? 30 : 31
int left = 0
if d < dim
    for k = d + 1 to dim
        int wd = dayofweek(timestamp(y, mo, k))
        if wd != dayofweek.saturday and wd != dayofweek.sunday
            left += 1

var int fwd = 0
fwd := month(time) != month(time[1]) ? 1 : fwd + 1
bool hold = left <= before - 1 or fwd < after

if hold and strategy.position_size == 0
    strategy.entry("TOM", strategy.long)
if not hold and strategy.position_size > 0
    strategy.close("TOM")
bgcolor(hold ? color.new(color.green, 88) : na)
