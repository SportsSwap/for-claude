//@version=6
// F07 - Lower band + IBS on index futures (quantitativo.substack.com, bot 12 in contracts).
// Chart: MNQ1!/NQ1! or MES1!/ES1! on 5 or 15 minutes, extended hours ON.
// Regular-session (09:30-16:00) bars are built on the chart. At the 16:00 bar: band = highest
// session high of the last N days - k x the 25-day average session range. Buy 1 contract when
// the close is below the band and IBS < 0.3; sell at a 16:00 close above the previous session's high.
// Validated on Nasdaq-100 1-minute data, 1 MNQ (N = 20, k = 3): 2011-2021 +$1,671/yr, 11 of 11 years
// up; 2022-2026 +$4,571/yr, profit factor 2.43, 72% winners, 5 of 5 years up. Best futures bot. Grade A.
// ES (N = 5, k = 2): +$1,325/yr.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("F07 Lower band IBS", overlay = true, process_orders_on_close = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1)

n = input.int(20, "Days for the highest high")
k = input.float(3.0, "Band = high minus k x average range", step = 0.25)
ibsMax = input.float(0.3, "Buy only when IBS is below", step = 0.05)

string TZ = "America/New_York"
bool inSess = not na(time(timeframe.period, "0930-1600", TZ))
bool newDay = inSess and (not inSess[1] or dayofmonth(time, TZ) != dayofmonth(time[1], TZ))
bool atClose = inSess and hour(time_close, TZ) == 16 and minute(time_close, TZ) == 0

var float hi = na
var float lo = na
var float prevHi = na
var array<float> highs = array.new<float>()
var array<float> ranges = array.new<float>()
if newDay
    hi := high
    lo := low
else if inSess
    hi := math.max(hi, high)
    lo := math.min(lo, low)

if atClose and not na(hi)
    highs.push(hi)
    ranges.push(hi - lo)
    if highs.size() > 60
        highs.shift()
    if ranges.size() > 60
        ranges.shift()
    if highs.size() >= math.max(n, 25)
        float hh = array.max(highs.slice(highs.size() - n, highs.size()))
        float ar = array.avg(ranges.slice(ranges.size() - 25, ranges.size()))
        float band = hh - k * ar
        float ibs = hi != lo ? (close - lo) / (hi - lo) : 0.5
        if strategy.position_size > 0 and not na(prevHi) and close > prevHi
            strategy.close("Long")
        else if strategy.position_size == 0 and close < band and ibs < ibsMax
            strategy.entry("Long", strategy.long)
    prevHi := hi
if timeframe.isdaily
    runtime.error("Use a 5 or 15 minute chart with extended hours on.")
