//@version=6
// F04 - Overnight drift in index futures (Boyarchenko, Larsen & Whelan 2023 and the overnight-return
// literature). Chart: MNQ1!/NQ1! (or MES1!/ES1!) on 1-15 minutes WITH extended hours on.
// Buy at the 16:00 bar's close when the close is above its 200-day average (and, optionally, after a
// down day); sell at the close of the 09:30-09:31 bar next morning (on a 1-minute chart = the open).
// Validated on Nasdaq-100 data, 1 MNQ with the trend filter: 2011-2021 +$695/yr; 2022-2026
// +$3,259/yr (profit factor 1.17, 4 of 5 years up). ES was weaker (+$356/yr). Grade B on NQ.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("F04 Overnight drift", overlay = true, process_orders_on_close = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1)

useTrend = input.bool(true, "Only above the 200-day average")
onlyDown = input.bool(false, "Only after a down day")

string TZ = "America/New_York"
bool atClose = hour(time_close, TZ) == 16 and minute(time_close, TZ) == 0
bool atOpen = hour(time, TZ) == 9 and minute(time, TZ) == 30
float sma200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200)[1], lookahead = barmerge.lookahead_on)
var float lastRthClose = na

if atOpen and strategy.position_size > 0
    strategy.close("Overnight", comment = "09:30")
if atClose
    bool ok = (not useTrend or close > sma200) and (not onlyDown or (not na(lastRthClose) and close < lastRthClose))
    if ok and strategy.position_size == 0
        strategy.entry("Overnight", strategy.long)
    lastRthClose := close
