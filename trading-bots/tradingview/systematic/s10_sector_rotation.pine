//@version=6
// Bot 10 - Sector momentum rotation (Moskowitz & Grinblatt 1999). Put it on any of the 9 SPDR
// sector ETFs (XLB XLE XLF XLI XLK XLP XLU XLV XLY) or IEF. Month end: hold the top K sectors by
// N-month return, equal weight; if SPY is below its 200-day average, hold IEF instead. Trades at the
// next open. The tester shows the leg for the chart's ticker; the table shows all of them.
// Validated 2013-2026 out of sample: 8.7%/yr, Sharpe 0.69, worst fall -23%. Grade C (could be luck).
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("Bot 10 Sector rotation", overlay = false, initial_capital = 10000,
     commission_type = strategy.commission.percent, commission_value = 0.04)

months = input.int(3, "Momentum months")
topK   = input.int(3, "Sectors to hold", minval = 1, maxval = 9)
useFilter = input.bool(true, "IEF when SPY is below its 200-day average")
int L = 21 * months
mom() => close / close[L] - 1
names = array.from("XLB", "XLE", "XLF", "XLI", "XLK", "XLP", "XLU", "XLV", "XLY")
m = array.from(request.security("XLB", "D", mom()), request.security("XLE", "D", mom()), request.security("XLF", "D", mom()),
     request.security("XLI", "D", mom()), request.security("XLK", "D", mom()), request.security("XLP", "D", mom()),
     request.security("XLU", "D", mom()), request.security("XLV", "D", mom()), request.security("XLY", "D", mom()))
[spyC, spyS] = request.security("SPY", "D", [close, ta.sma(close, 200)])
bool riskOff = useFilter and spyC < spyS

float w = 0.0
bool ready = not na(m.get(0)) and not na(m.get(8)) and not na(spyS)
if ready
    if riskOff
        w := syminfo.ticker == "IEF" ? 1.0 : 0.0
    else
        for i = 0 to 8
            int r = 0
            for j = 0 to 8
                if m.get(j) > m.get(i)
                    r += 1
            if r < topK and names.get(i) == syminfo.ticker
                w := 1.0 / topK

nextDay = time + (dayofweek == dayofweek.friday ? 3 : 1) * 86400000
bool monthEnd = month(nextDay) != month(time)
if monthEnd and ready
    float diff = w * strategy.equity / close - strategy.position_size
    if math.abs(diff) * close > 0.01 * strategy.equity
        strategy.order("rebalance", diff > 0 ? strategy.long : strategy.short, qty = math.abs(diff))

plot(w * 100, "Weight of this ticker (%)", color.teal, style = plot.style_stepline)
var table tb = table.new(position.top_right, 2, 11, border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, riskOff ? "SPY < 200d: hold IEF" : "Risk on")
    table.cell(tb, 1, 0, str.tostring(months) + "m return")
    for i = 0 to 8
        table.cell(tb, 0, i + 1, names.get(i))
        table.cell(tb, 1, i + 1, str.tostring(m.get(i) * 100, "#.#") + "%")
