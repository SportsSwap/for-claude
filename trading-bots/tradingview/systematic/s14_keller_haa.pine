//@version=6
// Bot 14 - Keller Hybrid Asset Allocation (Keller 2023). Rules as published on allocatesmartly.com.
// Momentum = average of the 1, 3, 6 and 12-month returns (21/63/126/252 trading days).
// Month end: if TIP's momentum is negative, hold 100% of the better of IEF and cash (SHY).
// Otherwise hold the top N of SPY IWM EFA EEM VNQ DBC IEF TLT at 1/N each; a pick with negative
// momentum is swapped for the better of IEF / cash. Trades at the next open.
// Put it on a chart of any of those tickers (or SHY): the tester trades that ticker's share of the
// bot; the table shows the allocation. Validated 2015-2026 out of sample: 10.0%/yr, Sharpe 0.98,
// worst fall -13%, and the published setting (top 4) was also the best plateau. Grade A.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("Bot 14 Keller HAA", overlay = false, initial_capital = 10000,
     commission_type = strategy.commission.percent, commission_value = 0.04)

topN = input.int(4, "Offensive assets to hold", minval = 1, maxval = 8)
mom() => ((close / close[21] - 1) + (close / close[63] - 1) + (close / close[126] - 1) + (close / close[252] - 1)) / 4
names = array.from("SPY", "IWM", "EFA", "EEM", "VNQ", "DBC", "IEF", "TLT")
m = array.from(request.security("SPY", "D", mom()), request.security("IWM", "D", mom()), request.security("EFA", "D", mom()),
     request.security("EEM", "D", mom()), request.security("VNQ", "D", mom()), request.security("DBC", "D", mom()),
     request.security("IEF", "D", mom()), request.security("TLT", "D", mom()))
float mTIP = request.security("TIP", "D", mom())
float mIEF = m.get(6)
float mSHY = request.security("SHY", "D", mom())
string safe = mIEF > mSHY ? "IEF" : "SHY"

float w = 0.0
bool ready = not na(mTIP) and not na(mSHY) and not na(m.get(5))
if ready
    if mTIP <= 0
        w := syminfo.ticker == safe ? 1.0 : 0.0
    else
        for i = 0 to 7
            int r = 0
            for j = 0 to 7
                if m.get(j) > m.get(i)
                    r += 1
            if r < topN
                string pick = m.get(i) > 0 ? names.get(i) : safe
                if pick == syminfo.ticker
                    w += 1.0 / topN

nextDay = time + (dayofweek == dayofweek.friday ? 3 : 1) * 86400000
bool monthEnd = month(nextDay) != month(time)
if monthEnd and ready
    float diff = w * strategy.equity / close - strategy.position_size
    if math.abs(diff) * close > 0.01 * strategy.equity
        strategy.order("rebalance", diff > 0 ? strategy.long : strategy.short, qty = math.abs(diff))

plot(w * 100, "Weight of this ticker (%)", color.teal, style = plot.style_stepline)
var table tb = table.new(position.top_right, 2, 11, border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, mTIP <= 0 ? "TIP canary negative: all in " + safe : "Offensive (TIP > 0)")
    table.cell(tb, 1, 0, "Momentum")
    for i = 0 to 7
        table.cell(tb, 0, i + 1, names.get(i))
        table.cell(tb, 1, i + 1, str.tostring(m.get(i) * 100, "#.#") + "%")
    table.cell(tb, 0, 9, "TIP")
    table.cell(tb, 1, 9, str.tostring(mTIP * 100, "#.#") + "%")
