//@version=6
// Bot 09 - Turn of the month (Lakonishok & Smidt 1988; McConnell & Xu 2008). Daily chart of SPY
// (or ES1!/NQ1!). Buy at the close N trading days before month end, sell at the close of trading
// day M of the new month. Weekends are skipped; exchange holidays are not, so a holiday can shift
// the entry by a day. Validated 2013-2026 out of sample on SPY: 5.9%/yr, Sharpe 0.66, worst fall
// -16%, 63% winning months, in the market a third of the time. Grade B.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("Bot 09 Turn of the month", overlay = true, process_orders_on_close = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.02, initial_capital = 10000)

before = input.int(5, "Enter N trading days before month end", minval = 1)
after  = input.int(3, "Exit at the close of trading day M", minval = 1)

int y = year(time)
int mo = month(time)
int d = dayofmonth(time)
int dim = mo == 2 ? (y % 4 == 0 ? 29 : 28) : (mo == 4 or mo == 6 or mo == 9 or mo == 11) ? 30 : 31
int left = 0
if d < dim
    for k = d + 1 to dim
        int wd = dayofweek(timestamp(y, mo, k))
        if wd != dayofweek.saturday and wd != dayofweek.sunday
            left += 1

var int fwd = 0
fwd := month(time) != month(time[1]) ? 1 : fwd + 1
bool hold = left <= before - 1 or fwd < after

if hold and strategy.position_size == 0
    strategy.entry("TOM", strategy.long)
if not hold and strategy.position_size > 0
    strategy.close("TOM")
bgcolor(hold ? color.new(color.green, 88) : na)
