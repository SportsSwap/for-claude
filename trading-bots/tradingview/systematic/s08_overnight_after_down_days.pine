//@version=6
// Bot 08 - Overnight hold after down days (overnight-return research: Cooper, Cliff & Gulen 2008;
// Lou, Polk & Skouras 2019). Use an INTRADAY chart (1 to 15 minutes, regular hours only) of SPY or QQQ.
// At the 16:00 close, after N down closes in a row and with price above the 200-day average,
// buy market-on-close; sell at the close of the first bar next morning (1-minute chart = the open).
// Validated 2013-2026 out of sample (SPY + QQQ): 2.4%/yr, Sharpe 0.82, worst fall -7%, in the
// market overnight only ~8% of nights. Grade A (small but clean).
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("Bot 08 Overnight after down days", overlay = true, process_orders_on_close = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.02, initial_capital = 10000)

downDays = input.int(3, "Down closes in a row")
useTrend = input.bool(true, "Only above the 200-day average")

string TZ = "America/New_York"
bool inSess = not na(time(timeframe.period, "0930-1600", TZ))
int closeMin = hour(time_close, TZ) * 60 + minute(time_close, TZ)
bool lastBar = inSess and closeMin >= 960
bool firstBar = inSess and (na(time(timeframe.period, "0930-1600", TZ)[1]) or dayofmonth(time, TZ) != dayofmonth(time[1], TZ))
float sma200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200)[1], lookahead = barmerge.lookahead_on)

var float prevClose = na
var int streak = 0
if firstBar and strategy.position_size > 0
    strategy.close("Overnight")
if lastBar
    streak := not na(prevClose) and close < prevClose ? streak + 1 : 0
    prevClose := close
    if streak >= downDays and (not useTrend or close > sma200) and strategy.position_size == 0
        strategy.entry("Overnight", strategy.long)

if timeframe.isdaily or timeframe.isweekly
    runtime.error("Use an intraday chart (1-15 minutes) for this strategy.")
