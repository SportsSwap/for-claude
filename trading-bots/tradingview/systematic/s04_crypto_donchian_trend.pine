//@version=6
// Bot 04 (and 17) - Crypto Donchian trend ensemble (after Zarattini, Pagani & Barbon 2025,
// "Catching Crypto Trends"). For each lookback N: go long when the close breaks above the
// highest high of the last N days; leave when it closes below the lowest low of the last N/2 days.
// Position = average of the N states x min(1, target vol / 90-day realised vol). Daily chart,
// trades at the next open. Validated on BTC 2020-2026 out of sample: 19.9%/yr, Sharpe 0.88,
// worst fall -34% (holding BTC: -77%). Grade B. Bot 17 = the same on several large coins.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("Bot 04 Crypto Donchian trend", overlay = false, initial_capital = 10000,
     commission_type = strategy.commission.percent, commission_value = 0.2)

targetVol = input.float(0.40, "Volatility target (0 = always full size)", step = 0.05)

dState(int n) =>
    var float st = 0.0
    float hi = ta.highest(high, n)[1]
    float lo = ta.lowest(low, math.max(2, int(n / 2)))[1]
    if st == 0 and close > hi
        st := 1.0
    else if st == 1 and close < lo
        st := 0.0
    st

float sig = (dState(5) + dState(10) + dState(20) + dState(30) + dState(60)) / 5
float vol = ta.stdev(math.log(close / close[1]), 90) * math.sqrt(365)
float size = targetVol > 0 ? math.min(1.0, targetVol / vol) : 1.0
float w = math.round(sig * size * 50) / 50

float diff = w * strategy.equity / close - strategy.position_size
if not na(vol) and math.abs(diff) * close > 0.02 * strategy.equity
    strategy.order("rebalance", diff > 0 ? strategy.long : strategy.short, qty = math.abs(diff))

plot(w * 100, "Position (% of equity)", color.orange, style = plot.style_stepline)
