//@version=6
// Bot 02 - Time-series momentum (Moskowitz, Ooi & Pedersen 2012; Hurst, Ooi & Pedersen 2017)
// Rule: on the last trading day of each month, hold this asset if its return over the last N
// trading days is positive, sized so the asset's expected volatility is (target / number of
// assets); the rest stays in cash. Trades at the next open.
// The full bot runs on SPY, EFA, EEM, IEF, TLT, LQD, GLD, DBC, VNQ (9 assets). Validated
// 2015-2026 out of sample: 3.6%/yr, Sharpe 0.78, worst fall -8%. Grade A.
// Not compiled here: paste into the Pine Editor and check it before relying on it. Not financial advice.
strategy("Bot 02 Time-series momentum", overlay = false, initial_capital = 10000,
     commission_type = strategy.commission.percent, commission_value = 0.04)

lookback  = input.int(63, "Momentum lookback (trading days)")
targetVol = input.float(0.10, "Portfolio volatility target", step = 0.01)
nAssets   = input.int(9, "Assets in the full bot")

ret  = close / close[lookback] - 1
lr   = math.log(close / close[1])
vol  = ta.stdev(lr, 120) * math.sqrt(252)
nextDay = time + (dayofweek == dayofweek.friday ? 3 : 1) * 86400000
bool monthEnd = month(nextDay) != month(time)
float w = ret > 0 and vol > 0 ? math.min(1.0, (targetVol / nAssets) / vol) : 0.0

if monthEnd and not na(vol)
    float target = w * strategy.equity / close
    float diff = target - strategy.position_size
    if math.abs(diff) * close > 0.01 * strategy.equity
        strategy.order("rebalance", diff > 0 ? strategy.long : strategy.short, qty = math.abs(diff))

plot(w * 100, "Weight of this asset (%)", color.teal, style = plot.style_stepline)
