//@version=6
// MACD 12/144/9 panel with the buffer drawn on it. Add it under the strategy (macd_dip_buy.pine).
// The dotted lines sit N x ATR away from zero. A buy only counts if the blue line crosses up
// BELOW the lower dotted line; a short only if it crosses down ABOVE the upper one.
// Green dot = a cross deep enough to count. Grey dot = a cross the buffer skips.
// The 200 EMA and lower-timeframe rules are not checked here; the strategy does that.

indicator("MACD 12/144/9 + buffer", shorttitle = "MACD buffer", overlay = false)

fastLen = input.int(12, "Fast length", minval = 1)
slowLen = input.int(144, "Slow length", minval = 1)
sigLen = input.int(9, "Signal smoothing", minval = 1)
atrLen = input.int(14, "ATR length", minval = 1)
minDepthAtr = input.float(0.0, "Buffer: N x ATR from zero (0 = off)", minval = 0, step = 0.25)

[macdLine, signalLine, hist] = ta.macd(close, fastLen, slowLen, sigLen)
band = minDepthAtr * ta.atr(atrLen)

plot(hist, "Histogram", style = plot.style_columns,
     color = hist >= 0 ? (hist > hist[1] ? #26A69A : #B2DFDB) : (hist < hist[1] ? #FF5252 : #FFCDD2))
plot(macdLine, "MACD", color = #2962FF)
plot(signalLine, "Signal", color = #FF6D00)
hline(0, "Zero", color = color.gray)
plot(minDepthAtr > 0 ? band : na, "Buffer above zero", color = color.new(color.gray, 20), style = plot.style_circles, linewidth = 1)
plot(minDepthAtr > 0 ? -band : na, "Buffer below zero", color = color.new(color.gray, 20), style = plot.style_circles, linewidth = 1)

crossUp = ta.crossover(macdLine, signalLine)
crossDown = ta.crossunder(macdLine, signalLine)
deepUp = crossUp and macdLine < -band and macdLine < 0
deepDown = crossDown and macdLine > band and macdLine > 0
plotshape(deepUp ? macdLine : na, "Cross up past buffer", style = shape.circle, location = location.absolute, color = color.lime, size = size.tiny)
plotshape(deepDown ? macdLine : na, "Cross down past buffer", style = shape.circle, location = location.absolute, color = color.fuchsia, size = size.tiny)
plotshape(crossUp and macdLine < 0 and not deepUp ? macdLine : na, "Cross up skipped", style = shape.circle, location = location.absolute, color = color.gray, size = size.tiny)
plotshape(crossDown and macdLine > 0 and not deepDown ? macdLine : na, "Cross down skipped", style = shape.circle, location = location.absolute, color = color.gray, size = size.tiny)
